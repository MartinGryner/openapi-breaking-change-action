{
  "name": "openapi-breaking-change-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that flags OpenAPI and Swagger changes likely to break existing API clients.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --legal-comments=eof",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
